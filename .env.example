# Application Server
PORT=8080
JWT_SECRET=your-secure-jwt-secret-key-change-this-for-production
AUTO_MIGRATE=true

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=go_auth
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:root@postgres:5432/go_auth?sslmode=disable

# Redis Configuration
REDIS_PORT=6380
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Mailpit Configuration
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# SMTP Configuration (Mailpit)
IS_LOCAL_DEV_WITHOUT_SMTP=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@goauth.local

# Auth Strategy Configuration
BCRYPT_COST=12
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_MINUTES=10
FORGOT_PASSWORD_OTP_TTL_MINUTES=10
RESET_TEMP_TOKEN_TTL_MINUTES=15

# Default Seed Data
SEED_ADMIN_EMAIL=admin@goauth.com
SEED_ADMIN_PASSWORD=Admin@123